#
# Automatic time zone from location — see README.md.
#
# Product-independent; pulled in by a product's bundle.json `sub_component`,
# like wallpaper and oniro-haps, so every leaf carries that product
# component's part name.

import("//build/ohos.gni")

_part_name = "product_${device_name}"

ohos_executable("location_timezone") {
  sources = [ "location_timezone.cpp" ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "hilog:libhilog",
    "i18n:intl_util",
    "init:libbegetutil",
    "ipc:ipc_single",
    "libpng:libpng",
    "location:lbsservice_common",
    "location:locator_sdk",
    "time_service:time_client",
  ]

  cflags_cc = [
    "-Wall",
    "-Wextra",
    "-Wno-unused-parameter",

    # The location inner-API headers leave struct fields to default init.
    "-Wno-missing-field-initializers",
  ]

  install_enable = true
  install_images = [ "system" ]
  part_name = _part_name
}

ohos_prebuilt_etc("location_timezone_cfg") {
  source = "location_timezone.cfg"
  relative_install_dir = "init"
  part_name = _part_name
}

group("location_timezone_group") {
  deps = [
    ":location_timezone",
    ":location_timezone_cfg",
  ]
}
