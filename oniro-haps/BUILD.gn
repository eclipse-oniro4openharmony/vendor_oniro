#
# Oniro distribution HAP set (the Oniro app store + FlorisBoard IME).
#
# oniro-haps.json is the single source of truth for the HAP set: one
# ohos_prebuilt_etc target is generated below for every module of every app in
# the descriptor (read_file is gn-gen-time and, unlike exec_script, not gated
# by the //.gn allowlist). These targets install the Oniro-customized HAPs on
# top of the stock applications/standard/hap set (SceneBoard provides the
# SystemUI / Launcher / Settings shell, so nothing stock is swapped out).
#
# This group is pulled into the image the vendor-owned way: the product
# component lists group("oniro_custom_haps") in its bundle.json `sub_component`
# (see vendor/oniro/hybris_generic/bundle.json), exactly like preinstall-config.
# That is why each generated target carries the PRODUCT's part_name
# (oniro_haps_part_name) — a leaf's part_name must match the part of the
# component that gathers it. No patch to applications/standard/hap is needed.
#
# The set is OPT-IN: unless oniro_install_custom_haps is true (see
# oniro_haps.gni) this generates no targets and the group is empty, so the
# default product build installs no Oniro-built HAP. That keeps the default
# image free of application content whose licences differ from the product's
# own, and it means a plain build does not require haps/ to have been
# populated.
#
# The HAP binaries under haps/ are NOT committed — when opting in, produce them
# first with the colocated build-oniro-haps.sh (which clones each app from its
# pinned remote in oniro-haps.json), or ninja will fail on the missing
# prebuilt_etc `source` input. See README.md.

import("//build/ohos.gni")
import("//vendor/oniro/oniro-haps/oniro_haps.gni")

_hap_targets = []
if (oniro_install_custom_haps) {
  # Read inside the branch: gn rejects a file-scope variable that goes out of
  # scope unused, which is what happens on the default (opt-out) path.
  _desc = read_file("oniro-haps.json", "json")
  foreach(app, _desc.apps) {
    _include = true
    if (defined(app.optional) && app.optional) {
      _include = oniro_include_florisboard
    }
    if (_include) {
      foreach(mod, app.modules) {
        _name = string_replace(mod.dest, ".hap", "_hap")
        ohos_prebuilt_etc(_name) {
          source = "haps/" + mod.dest
          module_install_dir = mod.install_dir
          part_name = oniro_haps_part_name
        }
        _hap_targets += [ ":" + _name ]
      }
    }
  }
}

group("oniro_custom_haps") {
  deps = _hap_targets
}
