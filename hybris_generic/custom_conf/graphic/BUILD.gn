import("//build/ohos.gni")
import("//vendor/${product_company}/${device_name}/product.gni")

# Hyper Graphic Manager policy (refresh-rate switching), per device through
# the config-policy layer /sys_prod/devices/<dev> (GetHgmXmlPath only accepts
# /sys_prod paths).  The Plinius panel offers 60/90/120 Hz: the policy keeps
# it at 60 Hz when idle and at 120 Hz while touching, scrolling and
# animating.  Devices without a file keep HGM disabled (fixed rate).
ohos_prebuilt_etc("hgm_policy_ansuz") {
  source = "devices/ansuz/hgm_policy_config.xml"
  install_enable = true
  install_images = [ sys_prod_base_dir ]
  part_name = "product_hybris_generic"
  module_install_dir = "devices/ansuz/etc/graphic"
}

group("graphic_config") {
  deps = [ ":hgm_policy_ansuz" ]
}
