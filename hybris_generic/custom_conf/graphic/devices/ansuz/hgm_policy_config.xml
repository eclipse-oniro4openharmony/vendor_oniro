    Hyper Graphic Manager policy for an LTPS (non-LTPO) panel, one built-in
    screen (id 0), modes 60 / 90 / 120 Hz. Rates only: no composer mode ids
    appear anywhere in this file (HGM maps rate -> mode index itself).

    Default "dynamic" mode: 60 Hz when idle, 120 Hz on touch / scroll /
    animation, back to 60 Hz once the screen stops producing frames
    (rs_idle_timeout_ms) or at the latest up_timeout_ms after touch-up.
-->
<HgmConfig version="1.0">
    <!-- settings mode id used when persist.rosen.sethgmrefreshratemode.enabled is unset (0) -->
    <Param name="default_refreshrate_mode" value="-1"/>

    <!-- name = rate reported to Settings, value = settings/xml mode id.
         Ids must be -1/1/2/3: HgmCore hard-codes {1:60, 2:90, 3:120} and Settings sends -1/1/2/3. -->
    <Params name="refresh_rate_4settings">
        <Setting name="-1" value="-1"/>
        <Setting name="60" value="1"/>
        <Setting name="90" value="2"/>
        <Setting name="120" value="3"/>
    </Params>

    <Params name="refreshRate_strategy_config">
        <!-- dynamic: 60..120, idle 60, touch-down votes 120 -->
        <Strategy name="dynamic" min="60" max="120" dynamicMode="1" idleFps="60" down="120"/>
        <Strategy name="fixed_60" min="60" max="60" dynamicMode="0"/>
        <Strategy name="fixed_90" min="90" max="90" dynamicMode="0"/>
        <Strategy name="fixed_120" min="120" max="120" dynamicMode="0"/>
    </Params>

    <!-- touch-up hold time and "no RS frame" idle timeout (both are the built-in defaults) -->
    <Params name="timeout_strategy_config">
        <Setting name="up_timeout_ms" value="3000"/>
        <Setting name="rs_idle_timeout_ms" value="600"/>
    </Params>

    <!-- HgmScreenInfo::GetScreenType() reports screen 0 as LTPO unconditionally, so the
         key MUST be "screen0_LTPO" even though the panel is LTPS. The value is just a
         name for the screen_config below; it deliberately does not contain "LTPO". -->
    <Params name="screen_strategy_config">
        <Strategy name="screen0_LTPO" type="LTPS-DEFAULT"/>
    </Params>

    <Params name="screen_config" type="LTPS-DEFAULT">
        <Setting id="-1" strategy="dynamic">
            <Category name="LTPO_config">
                <Ltpo name="switch" value="0"/>
            </Category>
            <Category name="app_list" multi_app_strategy="focus"/>
            <!-- RS-side property animations (render process). Speeds in mm/s, max -1 = unbounded. -->
            <Category name="property_animation_dynamic_settings">
                <DynamicSettings name="translate">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="scale">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="rotation">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
            </Category>
            <!-- App-process side: UI-thread property animations + ArkUI drag/fling scenes. -->
            <Category name="ace_scene_dynamic_settings">
                <DynamicSettings name="translate">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="scale">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="rotation">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="scrollable_drag_scene">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="scrollBar_drag_scene">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="swiper_drag_scene">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="refresh_drag_scene">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
                <DynamicSettings name="picker_drag_scene">
                    <SpeedThresholds name="1" min="0" max="-1" preferred_fps="120"/>
                </DynamicSettings>
            </Category>
        </Setting>
        <Setting id="1" strategy="fixed_60">
            <Category name="LTPO_config">
                <Ltpo name="switch" value="0"/>
            </Category>
            <Category name="app_list" multi_app_strategy="focus"/>
        </Setting>
        <Setting id="2" strategy="fixed_90">
            <Category name="LTPO_config">
                <Ltpo name="switch" value="0"/>
            </Category>
            <Category name="app_list" multi_app_strategy="focus"/>
        </Setting>
        <Setting id="3" strategy="fixed_120">
            <Category name="LTPO_config">
                <Ltpo name="switch" value="0"/>
            </Category>
            <Category name="app_list" multi_app_strategy="focus"/>
        </Setting>
    </Params>
</HgmConfig>
