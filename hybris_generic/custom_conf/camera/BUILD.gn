import("//build/ohos.gni")
import("//vendor/${product_company}/${device_name}/product.gni")

# The camera app (com.ohos.camera) takes its photo/preview/video sizes from a
# built-in table and merges a per-device diff found by config policy at
# etc/camera/CameraProfiles.json.  Its defaults happen to suit the Plinius;
# the X23's sensors offer other sizes (back 4000x3000, front 4608x3456), and
# a requested size the device lacks fails the capture session.  So the X23
# gets its own diff, under its config_dir_layer entry (init.x23.cfg).
ohos_prebuilt_etc("camera_profiles_x23") {
  source = "devices/x23/CameraProfiles.json"
  install_enable = true
  install_images = [ sys_prod_base_dir ]
  part_name = "product_hybris_generic"
  module_install_dir = "devices/x23/etc/camera"
}

ohos_prebuilt_etc("camera_profiles_ansuz") {
  source = "devices/ansuz/CameraProfiles.json"
  install_enable = true
  install_images = [ sys_prod_base_dir ]
  part_name = "product_hybris_generic"
  module_install_dir = "devices/ansuz/etc/camera"
}

group("camera_config") {
  deps = [
    ":camera_profiles_ansuz",
    ":camera_profiles_x23",
  ]
}
