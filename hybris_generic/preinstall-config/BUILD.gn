import("//build/ohos.gni")
import("//vendor/oniro/oniro-haps/oniro_haps.gni")

# The committed install_list.json describes the default (stock) image. When the
# build opts into the Oniro distribution HAP set, BMS needs a preinstall entry
# per added bundle too, so regenerate the list from oniro-haps.json.
_install_list = "./install_list.json"
_install_list_deps = []
if (oniro_install_custom_haps) {
  _generated_install_list = "$target_gen_dir/install_list.json"

  action("gen_install_list_with_oniro_haps") {
    script = "//vendor/oniro/oniro-haps/gen_preinstall_list.py"
    inputs = [
      "./install_list.json",
      "//vendor/oniro/oniro-haps/oniro-haps.json",
    ]
    outputs = [ _generated_install_list ]
    args = [
      "--install-list",
      rebase_path("./install_list.json", root_build_dir),
      "--descriptor",
      rebase_path("//vendor/oniro/oniro-haps/oniro-haps.json", root_build_dir),
      "--output",
      rebase_path(_generated_install_list, root_build_dir),
    ]
    if (!oniro_include_florisboard) {
      args += [ "--skip-optional" ]
    }
  }

  _install_list = _generated_install_list
  _install_list_deps = [ ":gen_install_list_with_oniro_haps" ]
}

ohos_prebuilt_etc("install_list_config") {
  source = _install_list
  deps = _install_list_deps
  relative_install_dir = "app"
  part_name = "product_hybris_generic"
}

ohos_prebuilt_etc("uninstall_list_config") {
  source = "./uninstall_list.json"
  relative_install_dir = "app"
  part_name = "product_hybris_generic"
}

ohos_prebuilt_etc("install_list_capability_config") {
  source = "./install_list_capability.json"
  relative_install_dir = "app"
  part_name = "product_hybris_generic"
}

ohos_prebuilt_etc("install_list_permissions_config") {
  source = "./install_list_permissions.json"
  relative_install_dir = "app"
  part_name = "product_hybris_generic"
}

group("preinstall-config") {
  deps = [
    ":install_list_capability_config",
    ":install_list_config",
    ":install_list_permissions_config",
    ":uninstall_list_config",
  ]
}
