# Per-device const params for the one-image-two-devices setup.
#
# init loads every "*.para" in a config dir first, then every
# "*.para.import" (base/startup/init/.../param_server.c:LoadDefaultParams),
# expanding ${...} in the import line against params already set. By then
# ohos.boot.hardware is live (LoadSpecialParam -> LoadParamFromCmdLine runs
# before InitLoadParamFiles), so this selects device/<hardware>.para.
#
# /sys_prod/etc/param is walked before /system/etc/param and const params are
# first-write-wins, so what we set here beats the defaults in
# /system/etc/param/ohos.para. A missing target (unknown hardware) is just a
# warning — the ohos.para defaults stand.
#
# The device/ subdir is NOT scanned as a param dir (ReadFileInDir skips
# DT_DIR), so these files are only ever pulled in through this import.
import /sys_prod/etc/param/device/${ohos.boot.hardware}.para
