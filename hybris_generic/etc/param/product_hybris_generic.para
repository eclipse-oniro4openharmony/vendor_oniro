const.product.brand=default
const.build.product=default

# HDC (OpenHarmony Device Connector). These are base defaults; on native boot
# hybris_native.para (loaded from /sys_prod/etc/param/, first-write-wins) flips
# usb to "enable" for USB hdc — see phase_n7_hdc_usb.md.
const.security.developermode.state = "true"
persist.hdc.mode.usb = "disable"
persist.hdc.mode.tcp = "enable"
persist.hdc.port = "8712"

# Disable seccomp — the Halium vendor HALs invoked over libhybris trip the
# default OHOS seccomp filters.
persist.init.debug.seccomp.enable = 0

# Disable screen timeout — keep display on indefinitely
const.settings.screen_never_sleep=true

# Default UI language / locale — English (UK) for European formatting
# (metric units, DD/MM dates, 24h time). Overrides base zh-Hans default
# from base/global/i18n/frameworks/intl/etc/i18n.para via first-write-wins
# (sys_prod loads before /system/etc/param).
const.global.language=en-Latn-GB
const.global.locale=en-Latn-GB
const.global.region=GB

# Both phones are dual-SIM. sys_prod params load before /system's
# telephony.para (first-write-wins for const.*), so this overrides its 1.
# The Plinius RIL bridge serves slot1/slot2 (MAX_SLOTS in
# device/soc/oniro/hybris_generic/hardware/ril).
const.telephony.slotCount=2

# The camera app records from an encoded camera stream (SURFACE_ES) on
# 'default' device types, which the hybris camera HAL cannot produce; this
# makes it hand YUV to the recorder, whose H.264 encoder is the MediaTek
# hardware one behind device/soc/oniro hardware/hybris_codec.  Read by the Oniro
# camera fork (RecorderConfigOperation.getVideoSourceType).
const.oniro.camera.video_source=yuv

# Video decoders (FCodec, and the HEVC/VP8/VP9/AV1 ones) write NV21 instead
# of NV12 into display surfaces when the player leaves the format to them:
# NV12 surfaces map to the flexible YCbCr_420_888, which MediaTek's gralloc
# lays out Cr-first, so the GPU showed every played video with U and V
# swapped.  NV21 maps to YCrCb_420_SP and displays correctly (as the camera
# preview does).  Read by the av_codec system_patch.
const.media.decoder.surface_pixel_format=nv21
